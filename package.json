{
  "name": "meshimap",
  "version": "0.1.0",
  "private": true,
  "description": "地図中心のグルメ発見・予約アプリ（利用者 / 店舗管理者 / システム管理者）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "mobile": "npm run start -w @meshimap/mobile",
    "mobile:ios": "npm run ios -w @meshimap/mobile",
    "mobile:android": "npm run android -w @meshimap/mobile",
    "api:dev": "npm run dev -w @meshimap/api",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:mutation": "npm run test:mutation --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@stryker-mutator/instrumenter": {
      "@babel/core": "~8.0.0",
      "@babel/preset-react": "~8.0.0",
      "@babel/preset-typescript": "~8.0.0",
      "@babel/plugin-proposal-decorators": "~8.0.0"
    }
  }
}
